rules_version = '2';

// Règles de sécurité Firestore de l'application.
// Principe : rien n'est lisible ni modifiable par défaut ; chaque collection
// n'ouvre que ce dont le code de `lib/services/firestore_service.dart` a besoin.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // uid de l'autre participant, dans un match à deux personnes.
    function otherUser(users) {
      return users[0] == request.auth.uid ? users[1] : users[0];
    }

    // Vrai si `other` a déjà liké l'utilisateur courant : c'est la condition
    // d'existence d'un match, vérifiée côté serveur et pas seulement côté app.
    function likedMe(other) {
      return exists(/databases/$(database)/documents/swipes/$(other)/actions/$(request.auth.uid))
        && get(/databases/$(database)/documents/swipes/$(other)/actions/$(request.auth.uid)).data.liked == true;
    }

    function isMatchParticipant(matchId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/matches/$(matchId))
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users;
    }

    // --- Profils ---
    // Lecture ouverte aux membres connectés : la découverte liste les profils,
    // et les écrans de match et de chat affichent celui de l'autre personne.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // --- Swipes ---
    // `swipes/{auteur}/actions/{cible}` : l'auteur écrit son action, et la
    // cible peut lire celle qui la concerne — c'est ce que fait `hasLikedMe`.
    match /swipes/{ownerUid}/actions/{targetUid} {
      allow read: if isSignedIn()
        && (request.auth.uid == ownerUid || request.auth.uid == targetUid);
      allow create, update: if isSignedIn() && request.auth.uid == ownerUid;
      allow delete: if false;
    }

    // --- Matchs ---
    match /matches/{matchId} {
      // `resource == null` autorise la lecture préalable que fait `createMatch`
      // sur un document qui n'existe pas encore ; sans ça la création échoue.
      allow get: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.users);
      allow list: if isSignedIn() && request.auth.uid in resource.data.users;

      // Impossible de se fabriquer un match avec quelqu'un qui ne t'a pas liké.
      allow create: if isSignedIn()
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && likedMe(otherUser(request.resource.data.users));

      // Après coup, seuls `lastMessage` et `lastMessageAt` évoluent : la liste
      // des participants est figée.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.users
        && request.resource.data.users == resource.data.users;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isMatchParticipant(matchId);
        allow create: if isMatchParticipant(matchId)
          && request.resource.data.senderId == request.auth.uid;
        // Un message envoyé n'est ni modifiable ni supprimable.
        allow update, delete: if false;
      }
    }

    // Rappel : tout chemin non listé ci-dessus est refusé par défaut.
  }
}
