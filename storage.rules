rules_version = '2';

// Photos de profil : `users/{uid}/photos/{fichier}`, cf. `StorageService`.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/photos/{fileName} {
      // Les autres membres doivent voir les photos dans le swipe et les chats.
      allow read: if request.auth != null;

      // Seul le propriétaire dépose ou supprime ses photos. `request.resource`
      // est nul sur une suppression, d'où le premier test.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && (request.resource == null
            || (request.resource.size < 10 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }
  }
}
